{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nulook-auto-care",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/review-moderate*"]
  },
  "d1_databases": [
    {
      "binding": "REVIEWS_DB",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REVIEW_IMAGES"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
